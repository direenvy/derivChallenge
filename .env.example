# Only needed for the optional LLM answering layer (--answerer llm).
# The default rule-based mode, validate.py, eval.py and the tests need none of
# this, and the LLM mode itself falls back to the rule-based composer when no
# key is present.
#
# Set whichever one you have. Gemini is picked first when both are present.

# https://aistudio.google.com/apikey  (free tier available, no SDK needed)
GEMINI_API_KEY=

# https://console.anthropic.com/  (requires: pip install anthropic)
ANTHROPIC_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-5-5
